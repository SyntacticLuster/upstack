[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/OperationsConsole.gd" id="1_console"]

[node name="OperationsConsole" type="PanelContainer"]
script = ExtResource("1_console")

[node name="VBox" type="VBoxContainer" parent="."]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="RationHardening" type="HBoxContainer" parent="VBox"]
size_flags_horizontal = 3

[node name="Label" type="Label" parent="VBox/RationHardening"]
text = "ration_hardening"

[node name="Mode" type="OptionButton" parent="VBox/RationHardening"]

[node name="Duration" type="SpinBox" parent="VBox/RationHardening"]

[node name="Apply" type="Button" parent="VBox/RationHardening"]
text = "Apply"

[node name="Result" type="Label" parent="VBox/RationHardening"]
text = "-"

[node name="LaborOverdrive" type="HBoxContainer" parent="VBox"]
