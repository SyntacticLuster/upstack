[node name="Intensity" type="SpinBox" parent="VBox/LaborOverdrive"]

[node name="Duration" type="SpinBox" parent="VBox/LaborOverdrive"]

[node name="Apply" type="Button" parent="VBox/LaborOverdrive"]
text = "Apply"

[node name="Result" type="Label" parent="VBox/LaborOverdrive"]
text = "-"

[node name="ExpeditionCompression" type="HBoxContainer" parent="VBox"]
