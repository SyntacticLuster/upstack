[node name="Intensity" type="SpinBox" parent="VBox/ExpeditionCompression"]

[node name="Duration" type="SpinBox" parent="VBox/ExpeditionCompression"]

[node name="Apply" type="Button" parent="VBox/ExpeditionCompression"]
text = "Apply"

[node name="Result" type="Label" parent="VBox/ExpeditionCompression"]
text = "-"

[node name="InformationThrottling" type="HBoxContainer" parent="VBox"]
size_flags_horizontal = 3

[node name="Label" type="Label" parent="VBox/InformationThrottling"]
text = "information_throttling"

[node name="Level" type="SpinBox" parent="VBox/InformationThrottling"]

[node name="Duration" type="SpinBox" parent="VBox/InformationThrottling"]

[node name="Apply" type="Button" parent="VBox/InformationThrottling"]
text = "Apply"

[node name="Result" type="Label" parent="VBox/InformationThrottling"]
